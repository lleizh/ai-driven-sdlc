# Show feature status (with phase tracking)
show_status() {
    local feature_id=$1

    if [[ -z "$feature_id" ]]; then
        print_error "Feature IDが必要です"
        return 1
    fi

    # Validate feature ID format
    if ! validate_feature_id "$feature_id"; then
        return 1
    fi

    local feature_dir="${FEATURES_DIR}/${feature_id}"

    if [[ ! -d "$feature_dir" ]]; then
        print_error "Feature ${feature_id} が見つかりません"
        return 1
    fi

    print_header "Feature ${feature_id} のステータス"

    # Load metadata safely (no code execution)
    if ! load_metadata "${feature_dir}"; then
        return 1
    fi

    # ========================================
    # 基本情報
    # ========================================
    echo "基本情報:"
    echo "  Feature ID:         ${feature_id}"
    echo "  Issue URL:          ${ISSUE_URL:-未設定}"
    echo "  リスクレベル:       ${RISK_LEVEL}"
    echo "  作成日:             ${CREATED_DATE}"
    echo ""

    # ========================================
    # フェーズ進捗（治理視点）
    # ========================================
    echo "フェーズ進捗:"

    # Phase 1: Planning
    if [[ -f "${feature_dir}/00_context.md" ]] && [[ -s "${feature_dir}/00_context.md" ]]; then
        echo -e "  ${GREEN}✓${NC} 1. Planning    - Context 作成済み"
    else
        echo -e "  ${YELLOW}◐${NC} 1. Planning    - Context 作成中"
    fi

    # Phase 2: Design
    local decision_status=$(grep "^Status:" "${feature_dir}/decisions.md" 2>/dev/null | head -1 | awk '{print $2}')
    if [[ "$decision_status" == "CONFIRMED" ]] || [[ "$decision_status" == "REVISED" ]]; then
        echo -e "  ${GREEN}✓${NC} 2. Design      - Decision CONFIRMED"
    elif [[ "$decision_status" == "PENDING" ]]; then
        echo -e "  ${YELLOW}◐${NC} 2. Design      - Decision PENDING (レビュー中)"
    else
        echo -e "  ${YELLOW}○${NC} 2. Design      - Decision 未確定"
    fi

    # Phase 3: Implementation
    if [[ -f "${feature_dir}/30_implementation_plan.md" ]] && [[ -s "${feature_dir}/30_implementation_plan.md" ]]; then
        if [[ "$STATUS" == "implementing" ]] || [[ "$STATUS" == "implemented" ]]; then
            echo -e "  ${GREEN}✓${NC} 3. Implement   - 実装中/完了"
        else
            echo -e "  ${YELLOW}◐${NC} 3. Implement   - 実装計画作成済み"
        fi
    else
        echo -e "  ${YELLOW}○${NC} 3. Implement   - 未開始"
    fi

    # Phase 4: Review
    if [[ -f "${feature_dir}/40_review_findings.md" ]] && [[ -s "${feature_dir}/40_review_findings.md" ]]; then
        local blocking_count=$(grep -c "Severity: MUST_FIX" "${feature_dir}/40_review_findings.md" 2>/dev/null | xargs || echo "0")
        if [[ $blocking_count -gt 0 ]]; then
            echo -e "  ${RED}⚠${NC} 4. Review      - MUST_FIX 問題あり (${blocking_count}件)"
        else
            echo -e "  ${GREEN}✓${NC} 4. Review      - レビュー完了"
        fi
    else
        echo -e "  ${YELLOW}○${NC} 4. Review      - 未実施"
    fi

    echo ""

    # ========================================
    # 治理チェックリスト（簡易版）
    # ========================================
    echo "治理チェックリスト（簡易）:"

    local checks_passed=0
    local checks_total=0

    # Check 1: Issue URL
    ((checks_total++))
    if [[ -n "$ISSUE_URL" ]] && [[ "$ISSUE_URL" != "https://github.com/owner/repo/issues/" ]]; then
        echo -e "  ${GREEN}✓${NC} Issue URL 設定済み"
        ((checks_passed++))
    else
        echo -e "  ${RED}✗${NC} Issue URL 未設定"
    fi

    # Check 2: Risks
    ((checks_total++))
    local risk_count=$(grep -c "^## Risk" "${feature_dir}/risks.md" 2>/dev/null | xargs || echo "0")
    if [[ $risk_count -gt 0 ]]; then
        echo -e "  ${GREEN}✓${NC} リスク記録済み (${risk_count}個)"
        ((checks_passed++))
    else
        echo -e "  ${RED}✗${NC} リスク未記録"
    fi

    # Check 3: Decision Status
    ((checks_total++))
    if [[ "$decision_status" == "CONFIRMED" ]] || [[ "$decision_status" == "REVISED" ]]; then
        echo -e "  ${GREEN}✓${NC} Decision 確定済み"
        ((checks_passed++))
    else
        echo -e "  ${YELLOW}○${NC} Decision 未確定 (${decision_status:-PENDING})"
    fi

    # Check 4: Implementation Plan (for Medium/High Risk)
    if [[ "$RISK_LEVEL" != "low" ]]; then
        ((checks_total++))
        if [[ -f "${feature_dir}/30_implementation_plan.md" ]] && [[ -s "${feature_dir}/30_implementation_plan.md" ]]; then
            echo -e "  ${GREEN}✓${NC} 実装計画作成済み"
            ((checks_passed++))
        else
            echo -e "  ${YELLOW}○${NC} 実装計画未作成 (${RISK_LEVEL} リスク)"
        fi
    fi

    echo ""
    echo "  合格率: ${checks_passed}/${checks_total}"
    echo ""

    # ========================================
    # ドキュメント一覧
    # ========================================
    echo "ドキュメント:"
    for doc in "${feature_dir}"/*.md; do
        if [[ -f "$doc" ]]; then
            local doc_name=$(basename "$doc")
            local line_count=$(wc -l < "$doc" | xargs)
            local status_icon="○"

            if [[ $line_count -gt 10 ]]; then
                status_icon="${GREEN}✓${NC}"
            elif [[ $line_count -gt 0 ]]; then
                status_icon="${YELLOW}◐${NC}"
            fi

            echo -e "  ${status_icon} ${doc_name} (${line_count} lines)"
        fi
    done
    echo ""

    # ========================================
    # 次のアクション提案
    # ========================================
    print_info "次のアクション:"

    if [[ -z "$ISSUE_URL" ]] || [[ "$ISSUE_URL" == "https://github.com/owner/repo/issues/" ]]; then
        echo "  → .metadata の ISSUE_URL を設定"
    elif [[ $risk_count -eq 0 ]]; then
        echo "  → risks.md にリスクを記録"
    elif [[ "$decision_status" != "CONFIRMED" ]] && [[ "$decision_status" != "REVISED" ]]; then
        echo "  → /sdlc-pr-design ${feature_id} で Design Review を開始"
        echo "  → レビュー後、/sdlc-decision ${feature_id} で Decision を確定"
    elif [[ ! -f "${feature_dir}/30_implementation_plan.md" ]] && [[ "$RISK_LEVEL" != "low" ]]; then
        echo "  → /sdlc-impl-plan ${feature_id} で実装計画を生成"
    elif [[ "$STATUS" == "implementing" ]] && [[ ! -f "${feature_dir}/40_review_findings.md" ]]; then
        echo "  → /sdlc-check ${feature_id} で実装を検証"
        echo "  → /sdlc-pr-code ${feature_id} で Implementation PR を作成"
    else
        echo "  → sdlc-cli validate ${feature_id} で詳細な検証を実行"
    fi
}

# Validate feature (Governance Checklist)
validate_feature() {
    local feature_id=$1

    if [[ -z "$feature_id" ]]; then
        print_error "Feature IDが必要です"
        return 1
    fi

    # Validate feature ID format
    if ! validate_feature_id "$feature_id"; then
        return 1
    fi

    local feature_dir="${FEATURES_DIR}/${feature_id}"

    if [[ ! -d "$feature_dir" ]]; then
        print_error "Feature ${feature_id} が見つかりません"
        return 1
    fi

    print_header "Feature ${feature_id} の検証（治理チェックリスト）"

    # Load metadata safely
    if ! load_metadata "${feature_dir}"; then
        return 1
    fi

    local errors=0
    local warnings=0
    local passed=0
    local total=0

    # ========================================
    # ✓ Check 1: Issue URL の存在
    # ========================================
    ((total++))
    print_info "[1/8] Issue URL の確認..."

    if [[ -n "$ISSUE_URL" ]] && [[ "$ISSUE_URL" != "https://github.com/owner/repo/issues/" ]]; then
        print_success "Issue URL: ${ISSUE_URL}"
        ((passed++))
    else
        print_error "Issue URL が設定されていません"
        print_info "  → .metadata の ISSUE_URL を設定してください"
        ((errors++))
    fi

    # ========================================
    # ✓ Check 2: risks.md の存在と内容
    # ========================================
    ((total++))
    echo ""
    print_info "[2/8] risks.md の確認..."

    if [[ ! -f "${feature_dir}/risks.md" ]]; then
        print_error "risks.md が存在しません"
        ((errors++))
    elif [[ ! -s "${feature_dir}/risks.md" ]]; then
        print_error "risks.md が空です"
        ((errors++))
    else
        local risk_count=$(grep -c "^## Risk" "${feature_dir}/risks.md" 2>/dev/null | xargs || echo "0")
        if [[ $risk_count -gt 0 ]]; then
            print_success "risks.md 存在（${risk_count}個のリスク記録）"
            ((passed++))

            # Check if top risks are identified
            local top_risk_count=$(grep -E "Risk Level.*: (High|Medium)" "${feature_dir}/risks.md" 2>/dev/null | wc -l | xargs)
            if [[ $top_risk_count -gt 0 ]]; then
                print_info "  → Top risks: ${top_risk_count}個"
            else
                print_warning "  → High/Medium リスクが記録されていません"
                ((warnings++))
            fi
        else
            print_error "リスクが記録されていません"
            ((errors++))
        fi
    fi

    # ========================================
    # ✓ Check 3: decisions.md の CONFIRMED（実装フェーズの場合）
    # ========================================
    ((total++))
    echo ""
    print_info "[3/8] decisions.md のステータス確認..."

    if [[ ! -f "${feature_dir}/decisions.md" ]]; then
        print_error "decisions.md が存在しません"
        ((errors++))
    else
        local decision_status=$(grep "^Status:" "${feature_dir}/decisions.md" | head -1 | awk '{print $2}')

        if [[ "$STATUS" == "implementing" ]] || [[ "$STATUS" == "implemented" ]]; then
            # 実装フェーズでは CONFIRMED が必須
            if [[ "$decision_status" == "CONFIRMED" ]] || [[ "$decision_status" == "REVISED" ]]; then
                print_success "Decision Status: ${decision_status}"
                ((passed++))

                # Update metadata
                safe_sed_inplace 's/DECISION_STATUS=.*/DECISION_STATUS=confirmed/' "${feature_dir}/.metadata" 2>/dev/null || true
            else
                print_error "Decision Status: ${decision_status}（実装フェーズでは CONFIRMED が必要）"
                print_info "  → /sdlc-decision ${feature_id} を実行してください"
                ((errors++))
            fi
        else
            # 設計フェーズでは PENDING も許容
            if [[ -n "$decision_status" ]]; then
                print_success "Decision Status: ${decision_status}（設計フェーズ）"
                ((passed++))
            else
                print_warning "Decision Status が設定されていません"
                ((warnings++))
            fi
        fi
    fi

    # ========================================
    # ✓ Check 4: design.md が FROZEN（decisions CONFIRMED の場合）
    # ========================================
    ((total++))
    echo ""
    print_info "[4/8] 20_design.md のステータス確認..."

    if [[ "$RISK_LEVEL" == "low" ]]; then
        print_info "  → Low Risk のため設計文書は不要"
        ((passed++))
    elif [[ ! -f "${feature_dir}/20_design.md" ]]; then
        if [[ "$RISK_LEVEL" == "medium" ]]; then
            print_warning "20_design.md が存在しません（Medium Risk では推奨）"
            ((warnings++))
        else
            print_error "20_design.md が存在しません（High Risk では必須）"
            ((errors++))
        fi
    else
        local design_status=$(grep "^Status:" "${feature_dir}/20_design.md" | head -1 | awk '{print $2}')

        if [[ "$DECISION_STATUS" == "confirmed" ]]; then
            if [[ "$design_status" == "FROZEN" ]]; then
                print_success "Design Status: FROZEN"
                ((passed++))
            else
                print_error "Design Status: ${design_status}（Decision CONFIRMED 後は FROZEN が必要）"
                print_info "  → /sdlc-decision で自動的に FROZEN になります"
                ((errors++))
            fi
        else
            print_success "Design Status: ${design_status:-DRAFT}（Decision 確定前）"
            ((passed++))
        fi
    fi

    # ========================================
    # ✓ Check 5: 30_implementation_plan.md の存在（中/高リスク）
    # ========================================
    ((total++))
    echo ""
    print_info "[5/8] 30_implementation_plan.md の確認..."

    if [[ "$RISK_LEVEL" == "low" ]]; then
        print_info "  → Low Risk のため実装計画は不要"
        ((passed++))
    elif [[ "$RISK_LEVEL" == "medium" ]]; then
        if [[ -f "${feature_dir}/30_implementation_plan.md" ]] && [[ -s "${feature_dir}/30_implementation_plan.md" ]]; then
            print_success "30_implementation_plan.md 存在"
            ((passed++))
        else
            print_warning "30_implementation_plan.md が存在しません（Medium Risk では推奨）"
            print_info "  → /sdlc-impl-plan ${feature_id} で生成"
            ((warnings++))
        fi
    else
        # High Risk
        if [[ -f "${feature_dir}/30_implementation_plan.md" ]] && [[ -s "${feature_dir}/30_implementation_plan.md" ]]; then
            print_success "30_implementation_plan.md 存在"
            ((passed++))
        else
            print_error "30_implementation_plan.md が存在しません（High Risk では必須）"
            print_info "  → /sdlc-impl-plan ${feature_id} で生成"
            ((errors++))
        fi
    fi

    # ========================================
    # ✓ Check 6: 40_review_findings.md の存在（PR前）
    # ========================================
    ((total++))
    echo ""
    print_info "[6/8] 40_review_findings.md の確認（PR前チェック）..."

    if [[ "$STATUS" == "implementing" ]] || [[ "$STATUS" == "implemented" ]]; then
        if [[ -f "${feature_dir}/40_review_findings.md" ]] && [[ -s "${feature_dir}/40_review_findings.md" ]]; then
            print_success "40_review_findings.md 存在"
            ((passed++))

            # Check for blocking issues
            local blocking_count=$(grep -c "Severity: MUST_FIX" "${feature_dir}/40_review_findings.md" 2>/dev/null | xargs || echo "0")
            if [[ $blocking_count -gt 0 ]]; then
                print_error "  → MUST_FIX の問題が ${blocking_count} 件あります"
                ((errors++))
            fi
        else
            print_warning "40_review_findings.md が存在しません（PR前に実行推奨）"
            print_info "  → /sdlc-check ${feature_id} で生成"
            ((warnings++))
        fi
    else
        print_info "  → 実装前のためスキップ"
        ((passed++))
    fi

    # ========================================
    # ✓ Check 7: 50_test_plan.md の存在（中/高リスク）
    # ========================================
    ((total++))
    echo ""
    print_info "[7/8] 50_test_plan.md の確認..."

    if [[ "$RISK_LEVEL" == "low" ]]; then
        print_info "  → Low Risk のためテスト計画は不要"
        ((passed++))
    elif [[ -f "${feature_dir}/50_test_plan.md" ]] && [[ -s "${feature_dir}/50_test_plan.md" ]]; then
        print_success "50_test_plan.md 存在"
        ((passed++))
    else
        if [[ "$RISK_LEVEL" == "high" ]]; then
            print_error "50_test_plan.md が存在しません（High Risk では必須）"
            ((errors++))
        else
            print_warning "50_test_plan.md が存在しません（Medium Risk では推奨）"
            ((warnings++))
        fi
    fi

    # ========================================
    # ✓ Check 8: 60_release_plan.md の存在（高リスク）
    # ========================================
    ((total++))
    echo ""
    print_info "[8/8] 60_release_plan.md の確認..."

    if [[ "$RISK_LEVEL" == "high" ]]; then
        if [[ -f "${feature_dir}/60_release_plan.md" ]] && [[ -s "${feature_dir}/60_release_plan.md" ]]; then
            print_success "60_release_plan.md 存在"
            ((passed++))
        else
            print_error "60_release_plan.md が存在しません（High Risk では必須）"
            ((errors++))
        fi
    else
        print_info "  → Low/Medium Risk のためリリース計画は不要"
        ((passed++))
    fi

    # ========================================
    # Summary
    # ========================================
    echo ""
    print_header "検証結果サマリー"

    echo "治理チェックリスト:"
    echo "  ✓ 合格: ${passed}/${total}"
    echo "  ⚠ 警告: ${warnings}"
    echo "  ✗ 失敗: ${errors}"
    echo ""

    if [[ $errors -eq 0 ]] && [[ $warnings -eq 0 ]]; then
        print_success "すべてのチェックに合格しました 🎉"
        echo ""
        print_info "次のアクション:"
        if [[ "$STATUS" == "planning" ]]; then
            echo "  1. /sdlc-pr-design ${feature_id} で Design Review PR を作成"
        elif [[ "$STATUS" == "designing" ]]; then
            echo "  1. Design Review を完了"
            echo "  2. /sdlc-decision ${feature_id} で Decision を確定"
        elif [[ "$STATUS" == "implementing" ]]; then
            echo "  1. /sdlc-check ${feature_id} で実装を検証"
            echo "  2. /sdlc-pr-code ${feature_id} で Implementation PR を作成"
        fi
        return 0
    elif [[ $errors -eq 0 ]]; then
        print_warning "警告がありますが、続行可能です"
        echo ""
        print_info "警告を解決することを推奨します"
        return 0
    else
        print_error "必須チェックに失敗しました"
        echo ""
        print_info "上記のエラーを修正してから再度実行してください"
        return 1
    fi
}

# List all features
list_features() {
    print_header "全Feature一覧"

    if [[ ! -d "$FEATURES_DIR" ]] || [[ -z "$(ls -A "$FEATURES_DIR" 2>/dev/null)" ]]; then
        print_info "Featureがまだありません"
        echo "新しいFeatureを作成: Claude Code内で /sdlc-init <github-issue-url>"
        return
    fi

    printf "%-20s %-10s %-15s %-12s %s\n" "FEATURE ID" "RISK" "STATUS" "DECISION" "CREATED"
    echo "────────────────────────────────────────────────────────────────────────────"

    for feature_dir in "${FEATURES_DIR}"/*; do
        if [[ -d "$feature_dir" ]] && [[ -f "${feature_dir}/.metadata" ]]; then
            # Load metadata safely (skip invalid entries)
            if load_metadata "${feature_dir}" 2>/dev/null; then
                local feature_name=$(basename "$feature_dir")

                printf "%-20s %-10s %-15s %-12s %s\n" \
                    "$feature_name" \
                    "${RISK_LEVEL:-unknown}" \
                    "${STATUS:-unknown}" \
                    "${DECISION_STATUS:-unknown}" \
                    "${CREATED_DATE:-unknown}"
            else
                local feature_name=$(basename "$feature_dir")
                printf "%-20s %-10s %-15s %-12s %s\n" \
                    "$feature_name" \
                    "ERROR" \
                    "ERROR" \
                    "ERROR" \
                    "ERROR"
            fi
        fi
    done
}

# Update decision status
update_decision() {
    local feature_id=$1
    local decision_status=$2

    if [[ -z "$feature_id" ]] || [[ -z "$decision_status" ]]; then
        print_error "Feature IDとDecisionステータスが必要です"
        echo "使用方法: sdlc-cli decision <feature-id> <pending|confirmed|revised>"
        return 1
    fi

    # Validate feature ID format
    if ! validate_feature_id "$feature_id"; then
        return 1
    fi

    if [[ ! "$decision_status" =~ ^(pending|confirmed|revised)$ ]]; then
        print_error "Decisionステータスは pending, confirmed, revised のいずれかです"
        return 1
    fi

    local feature_dir="${FEATURES_DIR}/${feature_id}"

    if [[ ! -d "$feature_dir" ]]; then
        print_error "Feature ${feature_id} が見つかりません"
        return 1
    fi

    # Use safe sed replacement
    if ! safe_sed_inplace "s/DECISION_STATUS=.*/DECISION_STATUS=${decision_status}/" "${feature_dir}/.metadata"; then
        print_error "Failed to update .metadata"
        return 1
    fi

    print_success "Feature ${feature_id} のDecisionステータスを ${decision_status} に更新"

    if [[ "$decision_status" == "confirmed" ]]; then
        print_success "実装を開始できます！"
    fi
}

# Update status
update_status() {
    local feature_id=$1
    local status=$2

    if [[ -z "$feature_id" ]] || [[ -z "$status" ]]; then
        print_error "Feature IDとステータスが必要です"
        echo "使用方法: sdlc-cli status <feature-id> <planning|design|implementing|testing|review|completed|blocked>"
        return 1
    fi

    # Validate feature ID format
    if ! validate_feature_id "$feature_id"; then
        return 1
    fi

    if [[ ! "$status" =~ ^(planning|design|implementing|testing|review|completed|blocked)$ ]]; then
        print_error "ステータスは planning, design, implementing, testing, review, completed, blocked のいずれかです"
        return 1
    fi

    local feature_dir="${FEATURES_DIR}/${feature_id}"

    if [[ ! -d "$feature_dir" ]]; then
        print_error "Feature ${feature_id} が見つかりません"
        return 1
    fi

    # Load metadata to get old status
    if ! load_metadata "${feature_dir}"; then
        return 1
    fi
    local old_status=$STATUS

    # Use safe sed replacement
    if ! safe_sed_inplace "s/STATUS=.*/STATUS=${status}/" "${feature_dir}/.metadata"; then
        print_error "Failed to update .metadata"
        return 1
    fi

    # Update LAST_UPDATED
    local current_date=$(date +%Y-%m-%d)
    if ! safe_sed_inplace "s/LAST_UPDATED=.*/LAST_UPDATED=${current_date}/" "${feature_dir}/.metadata"; then
        print_warning "Failed to update LAST_UPDATED"
    fi

    print_success "Feature ${feature_id} のステータスを ${old_status} → ${status} に更新"

    # Provide helpful tips based on status
    case "$status" in
        planning)
            print_info "次のステップ: /sdlc-decision でDecisionを確定してください"
            ;;
        design)
            print_info "次のステップ: Design PRを作成してレビューを受けてください"
            ;;
        implementing)
            print_info "次のステップ: 実装を進めてください"
            ;;
        testing)
            print_info "次のステップ: /sdlc-test でテストを実行してください"
            ;;
        review)
            print_info "次のステップ: Code Review PRを作成してください"
            ;;
        completed)
            print_success "Feature完了！お疲れ様でした！"
            ;;
        blocked)
            print_warning "ブロック中: 課題を解決後、ステータスを更新してください"
            ;;
    esac
}

# Update risk level
update_risk() {
    local feature_id=$1
    local risk_level=$2

    if [[ -z "$feature_id" ]] || [[ -z "$risk_level" ]]; then
        print_error "Feature IDとリスクレベルが必要です"
        echo "使用方法: sdlc-cli risk <feature-id> <low|medium|high>"
        return 1
    fi

    # Validate feature ID format
    if ! validate_feature_id "$feature_id"; then
        return 1
    fi

    if [[ ! "$risk_level" =~ ^(low|medium|high)$ ]]; then
        print_error "リスクレベルは low, medium, high のいずれかです"
        return 1
    fi

    local feature_dir="${FEATURES_DIR}/${feature_id}"

    if [[ ! -d "$feature_dir" ]]; then
        print_error "Feature ${feature_id} が見つかりません"
        return 1
    fi

    # Load metadata to get old risk level
    if ! load_metadata "${feature_dir}"; then
        return 1
    fi
    local old_risk=$RISK_LEVEL

    # Use safe sed replacement
    if ! safe_sed_inplace "s/RISK_LEVEL=.*/RISK_LEVEL=${risk_level}/" "${feature_dir}/.metadata"; then
        print_error "Failed to update .metadata"
        return 1
    fi

    print_success "リスクレベルを ${old_risk} から ${risk_level} に更新"

    if [[ "$risk_level" == "medium" ]] || [[ "$risk_level" == "high" ]]; then
        if [[ ! -f "${feature_dir}/20_design.md" ]]; then
            print_warning "中/高リスクには設計文書が推奨されます"
        fi
    fi

    if [[ "$risk_level" == "high" ]]; then
        if [[ ! -f "${feature_dir}/30_implementation_plan.md" ]]; then
            print_warning "高リスクには実装計画が必要です"
        fi
    fi
}

# Generate report (Management Overview)
generate_report() {
    print_header "SDLC 管理レポート"

    if [[ ! -d "$FEATURES_DIR" ]] || [[ -z "$(ls -A "$FEATURES_DIR" 2>/dev/null)" ]]; then
        print_info "Featureがまだありません"
        return
    fi

    # ========================================
    # 統計データ収集
    # ========================================
    local total=0
    local low_risk=0
    local medium_risk=0
    local high_risk=0
    local confirmed=0
    local planning=0
    local designing=0
    local implementing=0
    local completed=0
    local blocked=0
    local revision_count=0
    local total_risks=0
    local high_priority_risks=0

    for feature_dir in "${FEATURES_DIR}"/*; do
        if [[ -d "$feature_dir" ]] && [[ -f "${feature_dir}/.metadata" ]]; then
            # Load metadata safely (skip invalid entries)
            if ! load_metadata "${feature_dir}" 2>/dev/null; then
                continue
            fi
            ((total++))

            # Risk Level
            case "$RISK_LEVEL" in
                low) ((low_risk++)) ;;
                medium) ((medium_risk++)) ;;
                high) ((high_risk++)) ;;
            esac

            # Decision Status
            if [[ "$DECISION_STATUS" == "confirmed" ]]; then
                ((confirmed++))
            fi

            # Phase
            case "$STATUS" in
                planning) ((planning++)) ;;
                designing) ((designing++)) ;;
                implementing) ((implementing++)) ;;
                completed) ((completed++)) ;;
                blocked) ((blocked++)) ;;
            esac

            # Revisions
            if [[ -f "${feature_dir}/decisions.md" ]]; then
                local revisions=$(grep -c "^## Decision Revision" "${feature_dir}/decisions.md" 2>/dev/null | xargs || echo "0")
                revision_count=$((revision_count + revisions))
            fi

            # Risks
            if [[ -f "${feature_dir}/risks.md" ]]; then
                local risks=$(grep -c "^## Risk" "${feature_dir}/risks.md" 2>/dev/null | xargs || echo "0")
                total_risks=$((total_risks + risks))

                local high_risks=$(grep -E "Risk Level.*: High" "${feature_dir}/risks.md" 2>/dev/null | wc -l | xargs)
                high_priority_risks=$((high_priority_risks + high_risks))
            fi
        fi
    done

    # ========================================
    # サマリー表示
    # ========================================
    echo "📊 Feature サマリー"
    echo "────────────────────────────────────────"
    echo "  総Feature数:         ${total}"
    echo "  完了:                ${completed}"
    echo "  実装中:              ${implementing}"
    echo "  設計中:              ${designing}"
    echo "  計画中:              ${planning}"
    if [[ $blocked -gt 0 ]]; then
        echo -e "  ${RED}ブロック中:          ${blocked}${NC}"
    fi
    echo ""

    # ========================================
    # リスク分布
    # ========================================
    echo "⚠️  リスク分布"
    echo "────────────────────────────────────────"
    echo "  Low Risk:            ${low_risk}"
    echo "  Medium Risk:         ${medium_risk}"
    if [[ $high_risk -gt 0 ]]; then
        echo -e "  ${YELLOW}High Risk:           ${high_risk}${NC}"
    else
        echo "  High Risk:           ${high_risk}"
    fi
    echo ""
    echo "  総リスク記録数:      ${total_risks}"
    if [[ $high_priority_risks -gt 0 ]]; then
        echo -e "  ${RED}High 優先度リスク:   ${high_priority_risks}${NC}"
    else
        echo "  High 優先度リスク:   ${high_priority_risks}"
    fi
    echo ""

    # ========================================
    # 治理メトリクス
    # ========================================
    echo "🔍 治理メトリクス"
    echo "────────────────────────────────────────"
    echo "  Decision 確定済み:   ${confirmed}/${total}"

    local decision_rate=0
    if [[ $total -gt 0 ]]; then
        decision_rate=$((confirmed * 100 / total))
    fi

    if [[ $decision_rate -ge 80 ]]; then
        echo -e "  ${GREEN}Decision 確定率:     ${decision_rate}%${NC}"
    elif [[ $decision_rate -ge 50 ]]; then
        echo -e "  ${YELLOW}Decision 確定率:     ${decision_rate}%${NC}"
    else
        echo -e "  ${RED}Decision 確定率:     ${decision_rate}%${NC}"
    fi

    echo "  Decision Revision:   ${revision_count}件"

    if [[ $revision_count -gt 0 ]] && [[ $total -gt 0 ]]; then
        local avg_revision=$(calc "$revision_count / $total")
        if compare "$avg_revision > 2"; then
            echo -e "  ${RED}平均 Revision/Feature: ${avg_revision}${NC} (要注意)"
        elif compare "$avg_revision > 1"; then
            echo -e "  ${YELLOW}平均 Revision/Feature: ${avg_revision}${NC}"
        else
            echo -e "  ${GREEN}平均 Revision/Feature: ${avg_revision}${NC}"
        fi
    fi
    echo ""

    # ========================================
    # 健全性チェック
    # ========================================
    echo "✅ プロセス健全性"
    echo "────────────────────────────────────────"

    local health_issues=0

    # Check 1: Feature に Issue URL があるか
    local features_with_issue=0
    for feature_dir in "${FEATURES_DIR}"/*; do
        if [[ -d "$feature_dir" ]] && [[ -f "${feature_dir}/.metadata" ]]; then
            # Load metadata safely
            if load_metadata "${feature_dir}" 2>/dev/null; then
                if [[ -n "$ISSUE_URL" ]] && [[ "$ISSUE_URL" != "https://github.com/owner/repo/issues/" ]]; then
                    ((features_with_issue++))
                fi
            fi
        fi
    done

    local issue_rate=$((features_with_issue * 100 / total))
    if [[ $issue_rate -ge 90 ]]; then
        echo -e "  ${GREEN}✓${NC} Issue URL 設定率: ${issue_rate}%"
    else
        echo -e "  ${YELLOW}⚠${NC} Issue URL 設定率: ${issue_rate}% (Iron Rule 1 違反の可能性)"
        ((health_issues++))
    fi

    # Check 2: Decision 確定率
    if [[ $decision_rate -ge 80 ]]; then
        echo -e "  ${GREEN}✓${NC} Decision 確定率: ${decision_rate}%"
    else
        echo -e "  ${YELLOW}⚠${NC} Decision 確定率: ${decision_rate}% (Iron Rule 2 準拠を確認)"
        ((health_issues++))
    fi

    # Check 3: Risk 記録率
    local features_with_risks=0
    for feature_dir in "${FEATURES_DIR}"/*; do
        if [[ -d "$feature_dir" ]] && [[ -f "${feature_dir}/risks.md" ]]; then
            local risks=$(grep -c "^## Risk" "${feature_dir}/risks.md" 2>/dev/null | xargs || echo "0")
            if [[ $risks -gt 0 ]]; then
                ((features_with_risks++))
            fi
        fi
    done

    local risk_rate=$((features_with_risks * 100 / total))
    if [[ $risk_rate -ge 90 ]]; then
        echo -e "  ${GREEN}✓${NC} Risk 記録率: ${risk_rate}%"
    else
        echo -e "  ${YELLOW}⚠${NC} Risk 記録率: ${risk_rate}% (Iron Rule 3 違反の可能性)"
        ((health_issues++))
    fi

    # Check 4: Revision 頻度
    if [[ $total -gt 0 ]]; then
        local avg_revision=$(calc "$revision_count / $total")
        if compare "$avg_revision <= 1.5"; then
            echo -e "  ${GREEN}✓${NC} Revision 頻度: 正常範囲"
        else
            echo -e "  ${YELLOW}⚠${NC} Revision 頻度: 高め (設計品質の見直しを推奨)"
            ((health_issues++))
        fi
    fi

    echo ""

    if [[ $health_issues -eq 0 ]]; then
        print_success "プロセスは健全です 🎉"
    else
        print_warning "${health_issues}件の健全性問題が検出されました"
    fi

    echo ""

    # ========================================
    # 推奨アクション
    # ========================================
    print_info "推奨アクション:"

    if [[ $planning -gt 0 ]]; then
        echo "  → ${planning}件の Feature が計画中（Design Review を進める）"
    fi

    if [[ $designing -gt 0 ]]; then
        echo "  → ${designing}件の Feature が設計中（Decision 確定を進める）"
    fi

    if [[ $blocked -gt 0 ]]; then
        echo -e "  ${RED}→ ${blocked}件の Feature がブロック中（優先的に解決）${NC}"
    fi

    if [[ $issue_rate -lt 90 ]]; then
        echo "  → Issue URL が未設定の Feature を確認"
    fi

    if [[ $risk_rate -lt 90 ]]; then
        echo "  → リスクが未記録の Feature を確認"
    fi

    echo ""
    print_info "詳細: 'sdlc-cli list' または 'sdlc-cli status <feature-id>'"
}

# ========================================
# Archive completed features
# ========================================
archive_features() {
    local days=90  # Default: 90 days
    local dry_run=false
    local force=false

    # Parse options
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --days)
                days="$2"
                if [[ ! "$days" =~ ^[0-9]+$ ]]; then
                    print_error "Invalid --days value: $days (must be a positive integer)"
                    return 1
                fi
                shift 2
                ;;
            --dry-run)
                dry_run=true
                shift
                ;;
            --force)
                force=true
                shift
                ;;
            *)
                print_error "Unknown option: $1"
                echo "Usage: sdlc-cli archive [--days N] [--dry-run] [--force]"
                return 1
                ;;
        esac
    done

    print_header "Feature アーカイブ"

    if [[ "$dry_run" == true ]]; then
        print_info "🔍 Dry-run モード: 実際の移動は行いません"
        echo ""
    fi

    # Archive directory
    local archive_dir="${SDLC_DIR}/archive"
    local current_year=$(date +%Y)
    local current_date=$(date +%Y-%m-%d)
    local cutoff_date=$(date -v-${days}d +%Y-%m-%d 2>/dev/null || date -d "${days} days ago" +%Y-%m-%d 2>/dev/null)

    if [[ -z "$cutoff_date" ]]; then
        print_error "日付計算に失敗しました"
        return 1
    fi

    print_info "アーカイブ条件:"
    echo "  - STATUS: completed"
    echo "  - 完了後の経過日数: ${days}日以上"
    echo "  - カットオフ日: ${cutoff_date}"
    echo ""

    # Find completed features
    local feature_count=0
    local archived_count=0
    local skipped_count=0

    if [[ ! -d "$FEATURES_DIR" ]]; then
        print_error "Features ディレクトリが見つかりません: $FEATURES_DIR"
        return 1
    fi

    for feature_dir in "$FEATURES_DIR"/FEATURE-*; do
        [[ ! -d "$feature_dir" ]] && continue

        local feature_id=$(basename "$feature_dir")
        ((feature_count++))

        # Load metadata
        if ! load_metadata "$feature_dir"; then
            print_warning "Skipping ${feature_id}: .metadata の読み込みに失敗"
            ((skipped_count++))
            continue
        fi

        # Check STATUS
        if [[ "$STATUS" != "completed" ]]; then
            continue
        fi

        # Get completion date (use LAST_UPDATED or CREATED_DATE)
        local completion_date="${LAST_UPDATED:-$CREATED_DATE}"
        if [[ -z "$completion_date" ]]; then
            print_warning "Skipping ${feature_id}: 完了日が不明"
            ((skipped_count++))
            continue
        fi

        # Compare dates (YYYY-MM-DD format)
        if [[ "$completion_date" > "$cutoff_date" ]]; then
            continue
        fi

        # Determine archive year (use completion year)
        local archive_year="${completion_date:0:4}"
        local target_dir="${archive_dir}/${archive_year}/${feature_id}"

        echo "📦 ${feature_id}"
        echo "   完了日: ${completion_date}"
        echo "   移動先: sdlc/archive/${archive_year}/${feature_id}"

        if [[ "$dry_run" == true ]]; then
            print_info "   [Dry-run] 移動をスキップ"
            ((archived_count++))
            echo ""
            continue
        fi

        # Check if target already exists
        if [[ -d "$target_dir" ]]; then
            if [[ "$force" == false ]]; then
                print_warning "   移動先が既に存在します。--force で上書き可能"
                ((skipped_count++))
                echo ""
                continue
            else
                print_warning "   既存のアーカイブを削除します"
                rm -rf "$target_dir"
            fi
        fi

        # Create archive directory
        mkdir -p "${archive_dir}/${archive_year}"

        # Move with git mv (preserves history)
        if git mv "$feature_dir" "$target_dir" 2>/dev/null; then
            print_success "   移動完了"
            ((archived_count++))

            # Remove from GitHub Projects
            if [[ -n "$ISSUE_URL" ]]; then
                echo "   🗑️  GitHub Projects から削除中..."
                if remove_from_projects "$feature_id" "$ISSUE_URL"; then
                    print_success "   Projects から削除しました"
                else
                    print_warning "   Projects からの削除に失敗 (手動で削除してください)"
                fi
            fi
        else
            print_error "   git mv に失敗しました"
            ((skipped_count++))
        fi

        echo ""
    done

    # Summary
    echo "========================================"
    if [[ "$dry_run" == true ]]; then
        print_info "Dry-run 完了"
    else
        print_success "アーカイブ完了"
    fi
    echo "========================================"
    echo "  スキャンした Feature 数: ${feature_count}"
    echo "  アーカイブ対象:          ${archived_count}"
    echo "  スキップ:                ${skipped_count}"
    echo ""

    if [[ "$dry_run" == true ]]; then
        print_info "実際にアーカイブするには --dry-run を外して実行してください"
    elif [[ $archived_count -gt 0 ]]; then
        print_info "変更を commit してください:"
        echo "  git add ."
        echo "  git commit -m \"chore: archive ${archived_count} completed features\""
        echo "  git push origin develop"
    fi
}

# Remove feature from GitHub Projects
remove_from_projects() {
    local feature_id="$1"
    local issue_url="$2"

    # Check if .sdlc-config exists
    if [[ ! -f "${SCRIPT_DIR}/.sdlc-config" ]]; then
        return 1
    fi

    # Load config
    source "${SCRIPT_DIR}/.sdlc-config"

    if [[ -z "$GITHUB_PROJECT_ID" ]]; then
        return 1
    fi

    # Extract issue number from URL
    local issue_number
    issue_number=$(echo "$issue_url" | grep -oE '[0-9]+$')
    if [[ -z "$issue_number" ]]; then
        return 1
    fi

    # Get Issue node ID
    local issue_node_id
    issue_node_id=$(gh api graphql -f query='
      query($owner: String!, $repo: String!, $number: Int!) {
        repository(owner: $owner, name: $repo) {
          issue(number: $number) {
            id
          }
        }
      }
    ' -f owner="$GITHUB_OWNER" \
      -f repo="$GITHUB_REPO" \
      -F number="$issue_number" \
      --jq '.data.repository.issue.id' 2>/dev/null)

    if [[ -z "$issue_node_id" ]] || [[ "$issue_node_id" == "null" ]]; then
        return 1
    fi

    # Find project item by Feature ID
    local item_id
    item_id=$(gh api graphql -f query='
      query($projectId: ID!) {
        node(id: $projectId) {
          ... on ProjectV2 {
            items(first: 100) {
              nodes {
                id
                fieldValues(first: 20) {
                  nodes {
                    ... on ProjectV2ItemFieldTextValue {
                      text
                      field {
                        ... on ProjectV2Field {
                          name
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    ' -f projectId="$GITHUB_PROJECT_ID" \
      --jq ".data.node.items.nodes[] | select(.fieldValues.nodes[] | select(.field.name == \"Feature ID\" and .text == \"$feature_id\")) | .id" 2>/dev/null)

    if [[ -z "$item_id" ]] || [[ "$item_id" == "null" ]]; then
        # Try to find by content ID
        item_id=$(gh api graphql -f query='
          query($projectId: ID!) {
            node(id: $projectId) {
              ... on ProjectV2 {
                items(first: 100) {
                  nodes {
                    id
                    content {
                      ... on Issue {
                        id
                      }
                    }
                  }
                }
              }
            }
          }
        ' -f projectId="$GITHUB_PROJECT_ID" \
          --jq ".data.node.items.nodes[] | select(.content.id == \"$issue_node_id\") | .id" 2>/dev/null)
    fi

    if [[ -z "$item_id" ]] || [[ "$item_id" == "null" ]]; then
        return 1
    fi

    # Delete project item
    gh api graphql -f query='
      mutation($projectId: ID!, $itemId: ID!) {
        deleteProjectV2Item(input: {
          projectId: $projectId
          itemId: $itemId
        }) {
          deletedItemId
        }
      }
    ' -f projectId="$GITHUB_PROJECT_ID" \
      -f itemId="$item_id" > /dev/null 2>&1

    return $?
}

# ========================================
# Sync to GitHub Projects
# ========================================
sync_to_projects() {
    print_info "GitHub Projects への同期を開始します"
    echo ""

    # Check .sdlc-config
    if [[ ! -f "${SCRIPT_DIR}/.sdlc-config" ]]; then
        print_error ".sdlc-config が見つかりません"
        print_info "セットアップ: ./install.sh を実行してください"
        exit 1
    fi

    # Load config
    source "${SCRIPT_DIR}/.sdlc-config"

    if [[ -z "$PROJECT_ID" ]]; then
        print_error "PROJECT_ID が設定されていません"
        exit 1
    fi

    # Check gh CLI
    if ! command -v gh &> /dev/null; then
        print_error "gh CLI がインストールされていません"
        print_info "インストール: https://cli.github.com/"
        exit 1
    fi

    # Check authentication
    if ! gh auth status &> /dev/null; then
        print_error "GitHub 認証が必要です"
        print_info "実行: gh auth login"
        exit 1
    fi

    echo "Project ID: $PROJECT_ID"
    echo ""

    # Get all features
    local feature_count=0
    local synced_count=0
    local skipped_count=0
    local error_count=0

    for feature_dir in "${FEATURES_DIR}"/*; do
        if [[ ! -d "$feature_dir" ]]; then
            continue
        fi

        if [[ ! -f "${feature_dir}/.metadata" ]]; then
            continue
        fi

        ((feature_count++))

        # Load metadata
        if ! load_metadata "${feature_dir}"; then
            print_warning "Failed to load metadata: ${feature_dir}"
            ((error_count++))
            continue
        fi

        echo "────────────────────────────────────────"
        echo "Feature: ${FEATURE_ID}"

        # Skip if no Issue URL
        if [[ -z "$ISSUE_URL" ]] || [[ "$ISSUE_URL" == "https://github.com/owner/repo/issues/" ]]; then
            print_warning "Issue URL が設定されていません - スキップ"
            ((skipped_count++))
            echo ""
            continue
        fi

        # Extract issue number from URL
        local issue_number
        issue_number=$(echo "$ISSUE_URL" | grep -oE '[0-9]+$')

        if [[ -z "$issue_number" ]]; then
            print_warning "Issue URL から Issue 番号を抽出できません: $ISSUE_URL"
            ((error_count++))
            echo ""
            continue
        fi

        echo "Issue: #${issue_number}"

        # Get Issue node ID
        local issue_node_id
        issue_node_id=$(gh api graphql -f query='
          query($owner: String!, $repo: String!, $number: Int!) {
            repository(owner: $owner, name: $repo) {
              issue(number: $number) {
                id
              }
            }
          }
        ' -f owner="$REPO_OWNER" \
          -f repo="$REPO_NAME" \
          -F number="$issue_number" \
          --jq '.data.repository.issue.id' 2>/dev/null)

        if [[ -z "$issue_node_id" ]] || [[ "$issue_node_id" == "null" ]]; then
            print_error "Issue の node ID を取得できません: Issue #${issue_number}"
            ((error_count++))
            echo ""
            continue
        fi

        # Check if Item exists in Project by Feature ID
        local existing_item_id
        existing_item_id=$(gh api graphql -f query='
          query($projectId: ID!) {
            node(id: $projectId) {
              ... on ProjectV2 {
                items(first: 100) {
                  nodes {
                    id
                    content {
                      ... on Issue {
                        id
                        number
                      }
                    }
                    fieldValues(first: 20) {
                      nodes {
                        ... on ProjectV2ItemFieldTextValue {
                          text
                          field {
                            ... on ProjectV2Field {
                              name
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        ' -f projectId="$PROJECT_ID" \
          --jq ".data.node.items.nodes[] | select(.fieldValues.nodes[] | select(.field.name == \"Feature ID\" and .text == \"$FEATURE_ID\")) | .id" 2>/dev/null || true)

        # If not found by Feature ID, check by Issue content ID
        if [[ -z "$existing_item_id" ]]; then
            existing_item_id=$(gh api graphql -f query='
              query($projectId: ID!) {
                node(id: $projectId) {
                  ... on ProjectV2 {
                    items(first: 100) {
                      nodes {
                        id
                        content {
                          ... on Issue {
                            id
                          }
                        }
                      }
                    }
                  }
                }
              }
            ' -f projectId="$PROJECT_ID" \
              --jq ".data.node.items.nodes[] | select(.content.id == \"$issue_node_id\") | .id" 2>/dev/null || true)
        fi

        local item_id="$existing_item_id"

        # Add Item if not exists
        if [[ -z "$item_id" ]]; then
            echo "Project に Item を追加中..."

            item_id=$(gh api graphql -f query='
              mutation($projectId: ID!, $contentId: ID!) {
                addProjectV2ItemById(input: {
                  projectId: $projectId
                  contentId: $contentId
                }) {
                  item {
                    id
                  }
                }
              }
            ' -f projectId="$PROJECT_ID" \
              -f contentId="$issue_node_id" \
              --jq '.data.addProjectV2ItemById.item.id' 2>/dev/null)

            if [[ -z "$item_id" ]] || [[ "$item_id" == "null" ]]; then
                print_error "Item の追加に失敗しました"
                ((error_count++))
                echo ""
                continue
            fi

            print_success "Item を追加しました"
        else
            echo "✓ Item は既に存在します"
        fi

        # Get field options
        local field_options
        field_options=$(gh api graphql -f query='
          query($projectId: ID!) {
            node(id: $projectId) {
              ... on ProjectV2 {
                fields(first: 20) {
                  nodes {
                    ... on ProjectV2SingleSelectField {
                      id
                      name
                      options { id name }
                    }
                  }
                }
              }
            }
          }
        ' -f projectId="$PROJECT_ID" 2>/dev/null)

        # Update Status field
        if [[ -n "$STATUS" ]]; then
            local project_status
            case "$STATUS" in
                "planning") project_status="Planning" ;;
                "design") project_status="Design" ;;
                "implementing") project_status="Implementation" ;;
                "testing") project_status="Testing" ;;
                "review") project_status="Review" ;;
                "completed") project_status="Done" ;;
                "blocked") project_status="Blocked" ;;
                *) project_status="" ;;
            esac

            if [[ -n "$project_status" ]]; then
                local status_option_id
                status_option_id=$(echo "$field_options" | jq -r --arg name "$project_status" '.data.node.fields.nodes[] | select(.name == "Status") | .options[] | select(.name == $name) | .id')

                if [[ -n "$status_option_id" ]] && [[ "$status_option_id" != "null" ]]; then
                    if gh api graphql -f query='
                      mutation($projectId: ID!, $itemId: ID!, $fieldId: ID!, $optionId: String!) {
                        updateProjectV2ItemFieldValue(input: {
                          projectId: $projectId
                          itemId: $itemId
                          fieldId: $fieldId
                          value: { singleSelectOptionId: $optionId }
                        }) {
                          projectV2Item { id }
                        }
                      }
                    ' -f projectId="$PROJECT_ID" \
                      -f itemId="$item_id" \
                      -f fieldId="$FIELD_ID_STATUS" \
                      -f optionId="$status_option_id" > /dev/null 2>&1; then
                        echo "  ✓ Status: $project_status"
                    fi
                fi
            fi
        fi

        # Update Feature ID field
        if [[ -n "$FEATURE_ID" ]]; then
            if gh api graphql -f query='
              mutation($projectId: ID!, $itemId: ID!, $fieldId: ID!, $text: String!) {
                updateProjectV2ItemFieldValue(input: {
                  projectId: $projectId
                  itemId: $itemId
                  fieldId: $fieldId
                  value: { text: $text }
                }) {
                  projectV2Item { id }
                }
              }
            ' -f projectId="$PROJECT_ID" \
              -f itemId="$item_id" \
              -f fieldId="$FIELD_ID_FEATURE_ID" \
              -f text="$FEATURE_ID" > /dev/null 2>&1; then
                echo "  ✓ Feature ID: $FEATURE_ID"
            fi
        fi

        # Update Risk Level field
        if [[ -n "$RISK_LEVEL" ]]; then
            local project_risk
            case "$RISK_LEVEL" in
                "low") project_risk="Low" ;;
                "medium") project_risk="Medium" ;;
                "high") project_risk="High" ;;
                *) project_risk="" ;;
            esac

            if [[ -n "$project_risk" ]]; then
                local risk_option_id
                risk_option_id=$(echo "$field_options" | jq -r --arg name "$project_risk" '.data.node.fields.nodes[] | select(.name == "Risk Level") | .options[] | select(.name == $name) | .id')

                if [[ -n "$risk_option_id" ]] && [[ "$risk_option_id" != "null" ]]; then
                    if gh api graphql -f query='
                      mutation($projectId: ID!, $itemId: ID!, $fieldId: ID!, $optionId: String!) {
                        updateProjectV2ItemFieldValue(input: {
                          projectId: $projectId
                          itemId: $itemId
                          fieldId: $fieldId
                          value: { singleSelectOptionId: $optionId }
                        }) {
                          projectV2Item { id }
                        }
                      }
                    ' -f projectId="$PROJECT_ID" \
                      -f itemId="$item_id" \
                      -f fieldId="$FIELD_ID_RISK_LEVEL" \
                      -f optionId="$risk_option_id" > /dev/null 2>&1; then
                        echo "  ✓ Risk Level: $project_risk"
                    fi
                fi
            fi
        fi

        # Update Decision Status field
        if [[ -n "$DECISION_STATUS" ]]; then
            local project_decision
            case "$DECISION_STATUS" in
                "pending") project_decision="Pending" ;;
                "confirmed") project_decision="Confirmed" ;;
                "rejected") project_decision="Rejected" ;;
                *) project_decision="" ;;
            esac

            if [[ -n "$project_decision" ]]; then
                local decision_option_id
                decision_option_id=$(echo "$field_options" | jq -r --arg name "$project_decision" '.data.node.fields.nodes[] | select(.name == "Decision Status") | .options[] | select(.name == $name) | .id')

                if [[ -n "$decision_option_id" ]] && [[ "$decision_option_id" != "null" ]]; then
                    if gh api graphql -f query='
                      mutation($projectId: ID!, $itemId: ID!, $fieldId: ID!, $optionId: String!) {
                        updateProjectV2ItemFieldValue(input: {
                          projectId: $projectId
                          itemId: $itemId
                          fieldId: $fieldId
                          value: { singleSelectOptionId: $optionId }
                        }) {
                          projectV2Item { id }
                        }
                      }
                    ' -f projectId="$PROJECT_ID" \
                      -f itemId="$item_id" \
                      -f fieldId="$FIELD_ID_DECISION_STATUS" \
                      -f optionId="$decision_option_id" > /dev/null 2>&1; then
                        echo "  ✓ Decision Status: $project_decision"
                    fi
                fi
            fi
        fi

        print_success "${FEATURE_ID} の同期が完了しました"
        ((synced_count++))
        echo ""
    done

    # Summary
    echo "========================================"
    print_success "同期が完了しました"
    echo "========================================"
    echo "  総 Feature 数:       ${feature_count}"
    echo "  同期成功:            ${synced_count}"
    echo "  スキップ:            ${skipped_count}"
    if [[ $error_count -gt 0 ]]; then
        echo -e "  ${RED}エラー:              ${error_count}${NC}"
    else
        echo "  エラー:              ${error_count}"
    fi
    echo ""
}

# Main
main() {
    if [[ $# -eq 0 ]]; then
        show_help
        exit 0
    fi

    local command=$1
    shift

    case "$command" in
        status)
            # Check if updating status or showing status
            if [[ $# -ge 2 ]]; then
                update_status "$@"
            else
                show_status "$@"
            fi
            ;;
        validate)
            validate_feature "$@"
            ;;
        list)
            list_features
            ;;
        decision)
            update_decision "$@"
            ;;
        risk)
            update_risk "$@"
            ;;
        report)
            generate_report
            ;;
        sync)
            sync_to_projects "$@"
            ;;
        archive)
            archive_features "$@"
            ;;
        version)
            echo "SDLC CLI version ${VERSION}"
            ;;
        help|--help|-h)
            show_help
            ;;
        *)
            print_error "不明なコマンド: ${command}"
            echo "使用方法: sdlc-cli help"
            exit 1
            ;;
    esac
}

main "$@"
